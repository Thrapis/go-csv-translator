# IDE
.idea
.vscode

# Config
.env

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Lingvanex server: keep the python/bat, ignore the downloaded model files
third_party/lingvanex-server/*
!third_party/lingvanex-server/*.py
!third_party/lingvanex-server/*.bat

# Local run configs (keep the checked-in *.example.yaml templates)
/config/*.yaml
!/config/*.example.yaml
